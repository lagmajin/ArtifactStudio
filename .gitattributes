# Keep text files and source files stable across Windows, macOS, and Linux.
* text=auto

# Canonical repository/worktree line ending for source and project files.
*.c       text eol=lf
*.cc      text eol=lf
*.cpp     text eol=lf
*.cxx     text eol=lf
*.h       text eol=lf
*.hh      text eol=lf
*.hpp     text eol=lf
*.hxx     text eol=lf
*.ixx     text eol=lf
*.cppm    text eol=lf
*.cmake   text eol=lf
CMakeLists.txt text eol=lf

# Keep agent/developer instructions and repository metadata portable too.
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.py      text eol=lf
*.ps1     text eol=lf
*.sh      text eol=lf
