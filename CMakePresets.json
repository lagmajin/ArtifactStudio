                "ARTIFACT_DEPLOY_DIR": "C:/Users/lagma/Desktop/Artifact"
            },
            "environment": {
                "ONEAPI_ROOT": "C:/Program Files (x86)/Intel/oneAPI",
                "PATH": "C:/PROGRA~2/Intel/oneAPI/compiler/2025.3/bin;$penv{PATH}",
                "LIB": "C:/PROGRA~2/Intel/oneAPI/compiler/2025.3/lib;$penv{LIB}",
                "INCLUDE": "C:/PROGRA~2/Intel/oneAPI/compiler/2025.3/include;$penv{INCLUDE}"
            }
        },
        {
            "name": "x64-Debug-ClangCL-LLD",
            "displayName": "x64 Debug (clang-cl + lld-link)",
            "inherits": "x64-Debug-ClangCL",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_LINKER": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/lld-link.exe",
                "CMAKE_EXE_LINKER_FLAGS": "",
                "CMAKE_SHARED_LINKER_FLAGS": "",
                "CMAKE_MODULE_LINKER_FLAGS": "",
                "ARTIFACT_DEPLOY_DIR": "C:/Users/lagma/Desktop/Artifact-ClangCL-LLD"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x64-Debug-Agent",
            "configurePreset": "x64-Debug-Agent",
            "jobs": 1
        }
    ]
}
