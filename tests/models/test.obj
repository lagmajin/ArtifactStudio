# Test model - cube with UV
mtllib test.mtl
usemtl test_mat

v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1

